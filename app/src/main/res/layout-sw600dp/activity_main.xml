<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
            android:id="@+id/btnManipulacijaLokacija"
            android:layout_width="500dp"
            android:layout_height="75dp"
            android:layout_marginTop="100dp"
            android:text="Manipulacija lokacijama"
            android:textSize="34sp"
            app:layout_constraintEnd_toEndOf="@+id/btnTuristickeLokacije"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/btnTuristickeLokacije"
            app:layout_constraintTop_toBottomOf="@+id/btnOmiljeneLokacije" />

        <Button
            android:id="@+id/btnTuristickeLokacije"
            android:layout_width="500dp"
            android:layout_height="75dp"
            android:layout_marginStart="50dp"
            android:layout_marginTop="200dp"
            android:layout_marginEnd="50dp"
            android:text="@string/turisticke_lokacije"
            android:textSize="34sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.518"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnOmiljeneLokacije"
            android:layout_width="500dp"
            android:layout_height="75dp"
            android:layout_marginTop="100dp"
            android:text="@string/omiljene_lokacije"
            android:textSize="34sp"
            app:layout_constraintEnd_toEndOf="@+id/btnTuristickeLokacije"
            app:layout_constraintHorizontal_bias="0.071"
            app:layout_constraintStart_toStartOf="@+id/btnTuristickeLokacije"
            app:layout_constraintTop_toBottomOf="@+id/btnTuristickeLokacije" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>